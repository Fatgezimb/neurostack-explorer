# NeuroStack Explorer local configuration example
#
# This file contains no credentials. Copy it to .env.local only when local
# overrides are needed. Never place secrets or signed URLs in NEXT_PUBLIC_*.

# Browser-visible site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ARTIFACT_BASE_PATH=/artifacts/v1
NEXT_PUBLIC_DATASET_STATUS=verified

# Scientific artifact mode: synthetic | public
# Public mode reads the committed, checksummed derivative. It does not fetch the
# source NWB in a visitor's browser.
NEUROSTACK_DATA_MODE=public
NEUROSTACK_DATASET_STATUS=verified
NEUROSTACK_ENABLE_REMOTE_DATA=false
NEUROSTACK_ALLOW_PUBLIC_DATA_FETCH=false

# Local paths. Do not commit machine-specific absolute paths.
NEUROSTACK_DATA_DIR=./data
NEUROSTACK_CACHE_DIR=./.cache/neurostack
NEUROSTACK_ARTIFACT_DIR=./public/artifacts/v1

# Reproducibility defaults. Each generated artifact must record the actual seed.
NEUROSTACK_RANDOM_SEED=20260714

# Verified immutable source identity. The URL is used only by an explicitly
# authorized offline fetch; size and SHA-256 are still checked before reading.
NEUROSTACK_DATASET_IDENTIFIER=DANDI:000582/0.251111.2151
NEUROSTACK_DATASET_ASSET_URL=https://api.dandiarchive.org/api/assets/2b9e441b-56bc-4be2-893e-0e02d22d239d/download/
NEUROSTACK_DATASET_SHA256=43b3b435b953d22e276acc494af2926b63deaf15d2834531b2a87d08a8458a09

# Deployment remains prohibited until the owner gives explicit approval.
NEUROSTACK_DEPLOYMENT_APPROVED=false
